{
  "name": "netlist-graph-builder",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tools/run-unit-tests.mjs",
    "test:launcher": "node tests/e2e/launcher-e2e.mjs",
    "test:workbench": "node tests/e2e/workbench-e2e.mjs",
    "test:ui-workbench": "node tests/e2e/ui-workbench-e2e.mjs",
    "test:process-log": "node tests/e2e/process-log-e2e.mjs",
    "test:docs": "node tools/check_docs_links.mjs",
    "test:architecture": "node tools/check_architecture.mjs",
    "test:mapped-cases": "node tools/test-mapped-cases.mjs",
    "test:mapped-hard": "node tools/test-mapped-cases.mjs --hard",
    "benchmark": "node tools/benchmark-large.mjs",
    "benchmark:mapped": "node tools/benchmark-mapped-cases.mjs",
    "benchmark:workspace": "node tools/benchmark-workspace-cache.mjs",
    "benchmark:interaction": "node tools/benchmark-interaction.mjs",
