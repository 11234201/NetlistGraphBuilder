{
  "name": "netlist-graph-builder",
  "version": "1.6.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tools/run-unit-tests.mjs",
    "test:launcher": "node tests/e2e/launcher-e2e.mjs",
    "test:remote-full": "node tests/e2e/workbench_full_acceptance.mjs",
    "test:remote-protocol": "node tests/e2e/remote_workbench_protocol.mjs",
    "test:remote-workbench": "node tests/e2e/remote_workbench_acceptance.mjs",
    "test:workbench": "node tests/e2e/workbench-e2e.mjs",
    "test:ui-workbench": "node tests/e2e/ui-workbench-e2e.mjs",
    "test:process-log": "node tests/e2e/process-log-e2e.mjs",
    "test:aig": "node --test tests/unit/aig-*.test.js tests/unit/aig_*.test.js tests/unit/graphviz-*.test.js",
    "test:aig-browser": "node tests/e2e/aig-workbench-e2e.mjs",
    "test:aig-views": "node tests/e2e/aig_views_e2e.mjs",
    "test:aig-structure": "node tests/e2e/aig_structure_e2e.mjs",
    "test:show-path-browser": "node tests/e2e/show_path_e2e.mjs",
    "test:scoped-logic-browser": "node tests/e2e/blif_names_e2e.mjs && node tests/e2e/aig_search_first_e2e.mjs && node tests/e2e/aig_focused_e2e.mjs && node tests/e2e/netlist_reconvergence_e2e.mjs",
    "test:graphviz-browser": "node tests/e2e/graphviz-runtime-e2e.mjs",
    "test:docs": "node tools/check_docs_links.mjs",
    "test:architecture": "node tools/check_architecture.mjs",
    "test:mapped-cases": "node tools/test-mapped-cases.mjs",
    "test:mapped-hard": "node tools/test-mapped-cases.mjs --hard",
    "benchmark": "node tools/benchmark-large.mjs",
    "benchmark:aig": "node tools/benchmark-aig.mjs",
    "benchmark:aig-structure": "node tools/benchmark_aig_structure.mjs",
    "benchmark:aig-browser": "node tests/e2e/aig-performance-e2e.mjs",
    "benchmark:mapped": "node tools/benchmark-mapped-cases.mjs",
    "benchmark:workspace": "node tools/benchmark-workspace-cache.mjs",
    "benchmark:interaction": "node tools/benchmark-interaction.mjs",
    "benchmark:frontend": "node tests/e2e/frontend_interaction_performance.mjs",
    "analyze:eq012-layouts": "node tools/compare_eq012_layouts.mjs",
    "analyze:whole-layouts": "node tools/compare_whole_layouts.mjs",
    "analyze:layer-spans": "node tools/inspect_layer_spans.mjs",
    "analyze:long-edges": "node tools/inspect_long_edges.mjs",
    "analyze:unroutable": "node tools/inspect_unroutable.mjs",
    "release:windows": "powershell -ExecutionPolicy Bypass -File tools/build-windows-release.ps1",
    "test:liberty": "node --test tests/unit/liberty.test.js",
    "test:liberty-browser": "node tests/e2e/liberty-e2e.mjs",
    "benchmark:liberty": "node --expose-gc tools/benchmark_liberty.mjs"
  }
