digraph aig {
rankdir=BT;
splines=spline;
n1 [label="a", shape=triangle, style=filled, fillcolor=snow2];
n2 [label="b", shape=triangle, style=filled, fillcolor=snow2];
n3 [label="c", shape=triangle, style=filled, fillcolor=snow2];
n4 [label="d", shape=triangle, style=filled, fillcolor=snow2];
n5 [label="5", shape=ellipse, style=filled, fillcolor=white];
n6 [label="6", shape=ellipse, style=filled, fillcolor=white];
n7 [label="7", shape=ellipse, style=filled, fillcolor=white];
n8 [label="8", shape=ellipse, style=filled, fillcolor=white];
