n10 [label="10", shape=ellipse, style=filled, fillcolor=white];
n11 [label="11", shape=ellipse, style=filled, fillcolor=white];
n12 [label="12", shape=ellipse, style=filled, fillcolor=white];
po0 [label="masked", shape=invtriangle, style=filled, fillcolor=snow2];
po1 [label="shared", shape=invtriangle, style=filled, fillcolor=snow2];
po2 [label="y", shape=invtriangle, style=filled, fillcolor=snow2];
n1 -> n5 [id="n5:0", style=dashed];
n3 -> n5 [id="n5:1", style=solid];
n2 -> n6 [id="n6:0", style=solid];
n3 -> n6 [id="n6:1", style=solid];
n1 -> n7 [id="n7:0", style=solid];
n2 -> n7 [id="n7:1", style=solid];
n7 -> n8 [id="n8:0", style=solid];
n4 -> n8 [id="n8:1", style=solid];
n6 -> n9 [id="n9:0", style=dashed];
n4 -> n9 [id="n9:1", style=solid];
n5 -> n10 [id="n10:0", style=dashed];
n7 -> n10 [id="n10:1", style=dashed];
n10 -> n11 [id="n11:0", style=dashed];
n4 -> n11 [id="n11:1", style=dashed];
n8 -> n12 [id="n12:0", style=dashed];
n11 -> n12 [id="n12:1", style=dashed];
n9 -> po0 [id="po0:0", style=dashed];
n6 -> po1 [id="po1:0", style=solid];
n12 -> po2 [id="po2:0", style=dashed];
{rank=same; n1; n2; n3; n4;}
{rank=same; n5; n6; n7;}
{rank=same; n8; n9; n10;}
{rank=same; n11;}
{rank=same; n12;}
